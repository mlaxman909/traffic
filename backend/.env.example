# SignalAI Backend — Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and must never be committed.
#
#   cp .env.example .env

# ── Database Connection ────────────────────────────────────────────────────────
# For Postgres.app on macOS (no password required for local connections):
#   DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/signalai
#
# For standard PostgreSQL with password:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/signalai
#
# Find your macOS username: whoami
DATABASE_URL=postgresql://YOUR_MACOS_USERNAME@localhost:5432/signalai

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=SignalAI API
APP_VERSION=1.0.0

# ── Frontend (CORS) ───────────────────────────────────────────────────────────
# The React Vite dev server URL — allow it to call the API
FRONTEND_URL=http://localhost:5173
